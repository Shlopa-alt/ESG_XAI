# Скопируйте в deploy/.env и заполните.
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-long-random-string

# Порт платформы на хосте — только HTTPS (http:// на него перенаправляется).
# Сертификат: deploy/certs/server.crt и server.key; корневой lab-root-ca.crt ставят в доверенные.
HTTP_PORT=8080
# Cookie сессии только по HTTPS
COOKIE_SECURE=true
# Подсеть центра в формате CIDR (для локальной разработки 0.0.0.0/0 открывает всем; в Docker Desktop клиент приходит из 172.16.0.0/12)
ALLOWED_SUBNET=0.0.0.0/0

# local — заглушка для разработки (пароль = LOCAL_DEV_PASSWORD), ldap — вход через LDAP
AUTH_BACKEND=local
# Свой пароль обязателен: с «dev» backend не стартует
LOCAL_DEV_PASSWORD=[задайте пароль]
LOCAL_DEV_ROLE=researcher

# LDAP университета (значения выдаёт администратор)
LDAP_SERVER=ldap://ldap.example.local
LDAP_USER_DN_TEMPLATE=uid={login},ou=people,dc=example,dc=local
LDAP_USE_SSL=false
# Логины, которые станут owner при первом входе, JSON-список
INITIAL_OWNER_LOGINS=[]

# База знаний KBRAG (веб-сервер python kbrag.py web на этой машине) и служебный токен
# платформы: python kbrag.py access add platform --kb esg
KBRAG_URL=http://host.docker.internal:8000
KBRAG_TOKEN=

# Импорт статей через сайт. KB_INBOX_DIR — папка приёма PDF на этой машине (KBRAG ссылается
# на файлы в ней, не удалять); KB_IMPORT_TOKEN — общий секрет с обработчиком
# deploy/windows/kb_import_worker.py: python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_INBOX_DIR=C:/Users/<пользователь>/ESG_data/kb_inbox
KB_IMPORT_TOKEN=
KB_IMPORT_MAX_MB=60

# Запуск экспериментов из формы. ESG_DATA_HOST — папка данных и результатов на этой машине
# (срезы датасетов записаны в платформе путями внутри неё); RUNNER_TOKEN — общий секрет
# платформы и исполнителя runner-cpu
ESG_DATA_HOST=C:/Users/<пользователь>/ESG_data
RUNNER_TOKEN=
